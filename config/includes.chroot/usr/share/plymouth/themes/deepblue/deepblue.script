# DeepBlue Linux Plymouth boot splash
# Deep-blue gradient, gently pulsing logo, slim progress bar.

Window.SetBackgroundTopColor(0.043, 0.173, 0.333);    # #0b2c55
Window.SetBackgroundBottomColor(0.020, 0.059, 0.118); # #050f1e

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.angle = 0;

fun refresh_callback ()
  {
    if (status == "normal")
      {
        logo.angle += (2 * 3.14159 / 60) * 0.6;
        min_opacity = 0.45;
        opacity = (Math.Cos(logo.angle) + 1) / 2;
        opacity *= 1 - min_opacity;
        opacity += min_opacity;
        logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
        logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30);
        logo.sprite.SetOpacity(opacity);
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);

# --- Progress bar ---
progress_bar.original = Image("progress_bar_fill.png");
progress_bar.sprite = Sprite();
progress_bar.x = Window.GetX() + Window.GetWidth() / 2 - progress_bar.original.GetWidth() / 2;
progress_bar.y = Window.GetY() + Window.GetHeight() * 0.72;
progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 10);

progress_bg.image = Image("progress_bar_bg.png");
progress_bg.sprite = Sprite(progress_bg.image);
progress_bg.sprite.SetPosition(progress_bar.x, progress_bar.y, 9);

fun progress_callback (duration, progress)
  {
    width = Math.Int(progress_bar.original.GetWidth() * progress);
    if (width > 0)
      {
        progress_bar.image = progress_bar.original.Crop(0, 0, width, progress_bar.original.GetHeight());
        progress_bar.sprite.SetImage(progress_bar.image);
      }
  }

Plymouth.SetBootProgressFunction(progress_callback);

status = "normal";
